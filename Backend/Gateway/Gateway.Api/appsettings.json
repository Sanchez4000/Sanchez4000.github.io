{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "example-route": {
        "ClusterId": "example-cluster",
        "Match": {
          "Path": "/example/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/example" }
        ]
      }
    },
    "Clusters": {
      "example-cluster": {
        "Destinations": {
          "example-destination": {
            "Address": "http://localhost:5000"
          }
        }
      }
    }
  }
}
